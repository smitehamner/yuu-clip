{
  "name": "yuu-clip",
  "version": "0.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "directories": {
      "output": "dist"
    },
    "appId": "com.smitehamner.yuuclip",
    "productName": "yuu-clip",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "ask",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      { "from": "../dist/*.whl", "to": "." }
    ],
    "publish": null
  }
}
