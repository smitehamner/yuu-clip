{
  "name": "yuu-clip",
  "version": "0.1.21",
  "description": "yuu-clip - Gaming clip review and export tool",
  "author": "smitehamner",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "directories": {
      "output": "../build/installer"
    },
    "appId": "com.smitehamner.yuuclip",
    "productName": "yuu-clip",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true,
      "include": "installer.nsh"
    },
    "extraResources": [
      {
        "from": "../build/prebuilt-env/env.tar.gz",
        "to": "prebuilt-env.tar.gz"
      },
      {
        "from": "../build/prebuilt-env/prebuilt-env.version",
        "to": "prebuilt-env.version"
      },
      {
        "from": "../build/python-runtime",
        "to": "python",
        "filter": [
          "**/*",
          "!.version"
        ]
      },
      {
        "from": "../build/ffmpeg-runtime",
        "to": "ffmpeg",
        "filter": [
          "**/*",
          "!.version"
        ]
      },
      {
        "from": "resources/LICENSE-FFMPEG-GPL.txt",
        "to": "LICENSE-FFMPEG-GPL.txt"
      },
      {
        "from": "../build/llama-server-runtime",
        "to": "llama-server",
        "filter": [
          "**/*",
          "!.version"
        ]
      },
      {
        "from": "resources/LICENSE-LLAMA-CPP-MIT.txt",
        "to": "LICENSE-LLAMA-CPP-MIT.txt"
      }
    ],
    "publish": null
  }
}
