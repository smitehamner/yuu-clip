# rp-clipper direct dependencies
# --------------------------------
# This file is the INPUT to pip-tools (pip-compile).
# Do NOT install from this file directly.
# Instead run scripts/pin-deps.sh (Linux/macOS) or scripts/pin-deps.ps1 (Windows)
# to generate requirements.lock, then install with:
#
#   pip install --require-hashes -r requirements.lock
#
# To upgrade a single package:
#   pip-compile --generate-hashes --upgrade-package faster-whisper requirements.in

faster-whisper
typer[all]
sqlalchemy
platformdirs

# Optional: local GGUF inference backend. Install with: pip install "yuu-clip[llamacpp]"
# llama-cpp-python>=0.3,<1.0
