# Load order for the frontend bundle (yuu-dev bundle -> bundle.js).
#
# This is the single source of truth for the order the static JS files load in.
# `yuu-dev bundle` concatenates these files, in this order, into bundle.js, which
# index.html loads as one <script>. Add a new module here (in the right spot for
# its dependencies) and re-run `yuu-dev bundle`; do not add <script> tags to
# index.html. Blank lines and lines starting with `#` are ignored.
#
# This is plain ordered concatenation, not a module bundler: every file listed here
# stays a classic global-scope script, so top-level `function foo(){}` stays global
# and the inline onclick="foo()" handlers keep working.
#
# Modules that have been migrated to real ESM (import/export) are NOT listed here -
# they live in the esbuild graph rooted at main.esm.js and ship as bundle.esm.js
# (see scripts/build-esm.mjs). As a classic file is migrated to ESM, remove it from
# this manifest and add it to that graph. index.html loads bundle.esm.js first, then
# this bundle.js.

analyze.js
reel.js
contexts.js
settings.js
settings-previews.js
settings-installs.js
settings-backup.js
projects.js
sounds.js
hotwords.js
exportpresets.js
sensitive.js
split.js
speakers.js
voices.js
transcript.js
namecorrections.js
clipcreate.js
exporteditor.js
modeldownload.js
boot.js
